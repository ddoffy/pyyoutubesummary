{
  "manifest_version": 3,
  "name": "YouTube Summary",
  "version": "1.0.0",
  "description": "Summarize YouTube videos using AI - automatically captures cookies for authentication",
  "permissions": [
    "activeTab",
    "cookies",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://ytsum.ddoffy.org/*",
    "http://localhost:8181/*",
    "http://127.0.0.1:8181/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
